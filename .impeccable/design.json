  "narrative": {
    "northStar": "The useful maker's workspace",
    "overview": "The production portfolio extends the existing dev.play world: cool paper, cobalt ink, expressive type and a tangible little computer. Its editorial project surfaces let real work carry the story. This describes the implemented design, not a testimonial or a new claim about Denilson's professional history.  The console is a viewer for real public project screenshots and direct case-study links. Interior pages retain the identity with quieter reading layouts. The Orbit proposal is a separate, unindexed preview world; its palette and composition are not production tokens.",
    "keyCharacteristics": [
      "Cobalt identity on cool paper with dark ink for reading.",
      "Expressive Bricolage headlines and precise Space Grotesk instrumentation.",
      "A solid, open diagonal D shared by every identity export.",
      "Quiet editorial project layouts beside a tactile console.",
      "Stable controls, bilingual content and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Product Boundary Rule",
        "body": "Keep project-specific colors inside their project surfaces; the surrounding portfolio retains cobalt, ink and cool paper.",
        "section": "colors"
      },
      {
        "name": "The Reading Voice Rule",
        "body": "Use Bricolage for the main reading hierarchy and Space Grotesk for instrumentation; preserve actual Spanish and English copy.",
        "section": "typography"
      },
      {
        "name": "The Editorial Ground Rule",
        "body": "Keep editorial project stages flat; reserve physical depth for the console and diffuse lift for floated reading surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared D geometry and regenerate its exports from the canonical source.",
      "Do preserve cobalt, ink and cool paper around bounded project evidence.",
      "Do keep interactive targets stable and honor reduced-motion preferences.",
      "Do keep Spanish and English, static content and keyboard access synchronized.",
      "Do use real public screenshots and keep private data out of the site."
    ],
    "donts": [
      "Don't merge the Orbit preview's visual language into the production system.",
      "Don't turn legacy hard offset shadows into a rule for new editorial surfaces.",
      "Don't add decorative eyebrows, side stripes or glyph ornaments as hierarchy.",
      "Don't present sample findings as a real scan or an email draft as delivery."
    ]
  }

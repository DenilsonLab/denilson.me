{
  "name": "denilson.me",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests vite.config.ts",
    "format": "prettier --write src scripts tests *.json *.ts *.md .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests *.json *.ts *.md .github/workflows/*.yml",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "assets": "node scripts/prepare-assets.mjs",
    "assets:brand": "node scripts/prepare-brand.mjs",
    "assets:concepts": "node scripts/prepare-concept-assets.mjs",
    "convert:images": "npm run assets"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "lucide-react": "^0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
